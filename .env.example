# Suite source boundary. Gannon reads the shared HEL session; live uses operational APIs.
PARTNER_BRIEFING_SOURCE_MODE=live
SWIFT_REPLAY_CATALOG_URL=
SWIFT_REPLAY_SESSION_ID=

# Legacy standalone replay settings retained for compatibility.
# Operational mode uses the API host's UTC clock.
PARTNER_BRIEFING_API_DATA_SOURCE=operational

# Replay mode requires a fixed UTC clock and may identify an exercise scenario.
PARTNER_BRIEFING_REPLAY_NOW_UTC=
PARTNER_BRIEFING_REPLAY_SCENARIO=

# SWIFT_REPLAY_NOW_UTC is accepted as a suite-wide replay-clock alias.
